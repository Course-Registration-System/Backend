# 복사해서 .env 로 쓰세요. .env 는 커밋하지 않습니다.
# docker compose 와 백엔드(bootRun)가 같은 파일을 읽습니다. 비밀번호에 작은따옴표(')는 쓰지 않습니다.

# MySQL 접속 위치
DB_HOST=localhost
DB_PORT=3306
# 권한 스크립트(R__grants.sql)가 crs 를 가정하므로 바꾸지 않습니다.
MYSQL_DATABASE=crs

# 계정 비밀번호 (로컬에서는 아무 값이나 채워도 됩니다)
MYSQL_ROOT_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=

SERVER_PORT=8080

# 앱의 현재 시각(시드 시점). 비우면 실제 시각. T0 2027-02-10T18:00:00 / T1 2027-02-11T11:00:00 / T2 2027-03-04T11:00:00 / T3 2027-06-20T10:00:00
CLOCK_FIXED_AT=2027-02-10T18:00:00
